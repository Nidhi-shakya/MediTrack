# ==============================================================================
# MediTrack Environment Configuration Template
# [Requirement 4 & 12: Secure Environment Configuration]
# Copy this file to .env and fill in your actual environment values.
# NEVER commit your real .env file with production credentials to Git.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# JSON Web Token (JWT) Security Configuration
# Generate a high-entropy secret key in production (e.g. openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_signing_key_change_in_production
JWT_EXPIRES_IN=8h

# MongoDB Atlas Cloud Connection String
# Example: mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yourdomain.mongodb.net/meditrack_db?retryWrites=true&w=majority

# Staff Initial Access Credentials (Customizable PIN / Passwords)
RECEPTION_PIN=your_reception_security_pin_here
DOCTOR_PIN=your_doctor_security_pin_here
